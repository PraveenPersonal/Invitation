modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["npm", "cache", "verify"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "NODEJS"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
